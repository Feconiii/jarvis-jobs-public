# Jarvis Jobs — environment
# Copy to .env (gitignored). Everything here is optional.

# ── The dashboard ────────────────────────────────────────────────────────────
# JARVIS_PORT=4300          # dashboard port (default 4300)
# JARVIS_AUTO=0             # turn OFF the background workers (scan every 6 h,
#                           # description reading, liveness, daily curation)

# ── Claude (the writers and the daily curation) ──────────────────────────────
# The resume, answer, letter and curation writers call the `claude` CLI
# (Claude Code). Install it and sign in once; no API key goes here.
# JARVIS_CLI_MODEL=sonnet,haiku     # model ladder for resumes and letters
# JARVIS_ANSWER_MODEL=opus,sonnet   # model ladder for application answers

# ── Wider discovery (optional) ───────────────────────────────────────────────
# Adzuna's official API, used by discover-sources.mjs when set.
# Free keys: https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# ── Gmail (optional) ─────────────────────────────────────────────────────────
# The Gmail reader is connected from the dashboard, read-only, with your own
# Google OAuth client. Nothing goes here.
